  "scripts": {
    "android:dev-debug": "react-native run-android --mode=devDebug --appId=com.goalwith.dev",
    "android:staging-debug": "react-native run-android --mode=stagingDebug",
    "android:prod-debug": "react-native run-android --mode=prodDebug",
    "android:dev-release-apk": "cd android && ./gradlew clean && ./gradlew assembleDevRelease && cd .. && echo 'find APK in android/app/build/outputs/apk/dev/release'",
    "android:staging-release-apk": "cd android && ./gradlew clean && ./gradlew assembleStagingRelease && cd .. && echo 'find APK in android/app/build/outputs/apk/staging/release'",
    "android:prod-release-apk": "cd android && ./gradlew clean && ./gradlew assembleProdRelease && cd .. && echo 'find APK in android/app/build/outputs/apk/prod/release'",
    "android:prod-release-aab": "cd android && ./gradlew clean && ./gradlew bundleProdRelease && cd .. && echo 'find AAB in android/app/build/outputs/apk/prod/release'",
    "android": "react-native run-android",
    "ios:dev": "react-native run-ios --scheme Development",
    "ios:prod": "react-native run-ios --scheme Production",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
