default_platform(:ios)

require 'json'

platform :ios do
  def updateVersion(options)
    if options[:version]
      version = options[:version]
    else
      version = prompt(text: "Enter the version type or specific version\n(major, minor, patch or 1.0.0): ")
    end

    re = /\d+.\d+.\d+/
    versionNum = version[re, 0]

    if (versionNum)
      increment_version_number(
        version_number: versionNum
      )
    elsif (version == 'major' || version == 'minor' || version == 'patch')
      increment_version_number(
        bump_type: version
      )
    else
      UI.user_error!("[ERROR] Wrong version!!!!!!")
    end
  end
  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots(workspace: "GoalWith.xcworkspace", scheme: "Development")
    upload_to_app_store(skip_binary_upload: true, skip_metadata: true)
  end

  def load_package_json
    package_json_path = File.expand_path("../../package.json", Dir.pwd)
    JSON.parse(File.read(package_json_path))
  end

  def get_calculated_build_number(version)
    major, minor, patch = version.split(".").map(&:to_i)
    return major * 1000000 + minor * 1000 + patch + 1
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do |options|
    cert
    sigh(force: true)
    package_json = load_package_json
    updateVersion(version: package_json["version"])
    build_number = get_calculated_build_number(package_json["version"])
    increment_build_number(xcodeproj: "GoalWith.xcodeproj", build_number: build_number)
    build_app(workspace: "GoalWith.xcworkspace", scheme: "Production")
    upload_to_testflight
  end
  desc "Push a new release build to the App Store"
  lane :release do |options|
    cert
    sigh(force: true)
    package_json = load_package_json
    updateVersion(version: package_json["version"])
    build_number = get_calculated_build_number(package_json["version"])
    increment_build_number(xcodeproj: "GoalWith.xcodeproj", build_number: build_number)
    build_app(workspace: "GoalWith.xcworkspace", scheme: "Production")
    upload_to_app_store(
      force: true,
      reject_if_possible: true,
      skip_metadata: false,
      skip_screenshots: true,
      languages: ['ko'],
      release_notes: {
        "default" => "bug fixed",
        "ko" => "버그 수정"
      },
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_install: true,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
      }
    )
  end
  desc "프로덕션 환경으로 JS 업데이트 배포"
  lane :update_prod do
    # 1. 프로젝트 루트(../..)로 이동해서 명령어를 실행해야 package.json을 찾을 수 있음
    Dir.chdir("../..") do
      # 2. APP_VARIANT=prod를 주입하여 .env.prod를 읽게 함
      # 3. --branch production: 채널과 브랜치를 일치시킴
      sh("APP_VARIANT=prod eas update --branch production --message 'Fastlane Update'")
    end
  end
  desc "개발 환경으로 JS 업데이트 배포"
  lane :update_dev do
    # 개발 배포도 마찬가지로 루트로 이동 필요
    Dir.chdir("../..") do
      sh("APP_VARIANT=dev eas update --branch dev --message 'Dev Update'")
    end
  end
end

